            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and r.thingId == \"kz.kyzyltas.mine:kpi\" and r._field == \"value_current_tph_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\"])"
